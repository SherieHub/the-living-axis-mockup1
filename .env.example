# Which way every image slot renders.
#
#   placeholder  (default) — every slot is a labelled EMPTY frame carrying the
#                            shot brief. The honest version: nothing can be
#                            mistaken for the brand's own photography.
#   preview                — treated stand-in photography. The dressed version,
#                            for showing the client what the layouts do.
#
# Both render from the same build, so you can present either during the
# walkthrough. The practitioner portrait slots stay empty in BOTH modes.
VITE_PHOTO_MODE=placeholder

# The live domain, e.g. https://thelivingaxis.com (no trailing slash).
#
# Leave EMPTY until the client confirms a domain. While it is empty the build
# deliberately omits <link rel="canonical"> and og:url rather than emitting a
# placeholder — a canonical pointing at a domain that does not exist is acted on
# by crawlers and link-preview services, so nothing is better than something.
# Setting this activates canonical URLs, og:url and LocalBusiness `url` with no
# code change.
VITE_SITE_URL=
